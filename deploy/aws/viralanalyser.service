[Unit]
Description=TRIBE v2 Viral Analyser (FastAPI on uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/workspace/app
EnvironmentFile=/etc/viralanalyser.env
ExecStart=/workspace/app/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
